# Copy to .env and fill in for local development.
# Not required for the real-estate agent in its current (LLM-free) form,
# but wired up in core/ for when agents/real_estate/analyze.py starts
# calling the Anthropic Batch API for briefs.

ANTHROPIC_API_KEY=
FRED_API_KEY=
CENSUS_API_KEY=

# Safety valve: core.costs raises once a single run's estimated spend
# crosses this, in USD.
MAX_RUN_USD=0.50
