__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.venv/
venv/
*.egg-info/
.env

# Large downloaded/derived data - never committed
data/cache/real_estate/*
!data/cache/real_estate/.gitkeep

# Published output (agents_core.paths.publish_dir(), default "public-data/")
# is regenerated by the agent on every run; keep it out of the repo until a
# website build actually consumes it. The reusable run-agent.yml workflow
# force-pushes this directory to a separate `data` branch instead.
# schemas/*.json IS committed to main (small, useful for PR diffs of the
# site contract) even though it's also regenerated and pushed to the data
# branch alongside public-data/.
public-data/

data/costs.jsonl
evals/results/*
!evals/results/.gitkeep

# Local per-checkout venvs and caches
agents-core/.venv/
agents-core/.pytest_cache/
agents-core/.ruff_cache/
agents-core/__pycache__/
