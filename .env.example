# Copy to .env for local runs (agents-run loads it without overriding real env
# vars). Never commit real values.

# Read by agents_core.llm. If ANTHROPIC_API_KEY is unset (some cloud dev
# environments reserve that name), AGENTS_ANTHROPIC_API_KEY is used instead.
ANTHROPIC_API_KEY=
# AGENTS_ANTHROPIC_API_KEY=

# Read by this agent's fetchers. FRED is needed for rates/affordability and the
# national construction/Case-Shiller blocks; the Census key is optional.
FRED_API_KEY=
CENSUS_API_KEY=

# agents_core.settings overrides, shown at their defaults:
# AGENTS_CORE_MAX_RUN_USD=0.50
# AGENTS_CORE_PUBLISH_DIR=public-data
# AGENTS_CORE_DATA_DIR=data
