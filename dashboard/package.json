{
  "name": "real-estate-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/fetch-data.mjs --if-missing",
    "dev": "vite",
    "prebuild": "node scripts/fetch-data.mjs --if-missing",
    "build": "vite build",
    "preview": "vite preview",
    "gen:schema": "node scripts/gen-schema.mjs",
    "check:schema": "node scripts/gen-schema.mjs --check",
    "fetch-data": "node scripts/fetch-data.mjs",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "screenshots": "SCREENSHOTS=1 playwright test e2e/screenshots.spec.ts",
    "check:bundle": "node scripts/check-bundle.mjs --budget 300",
    "check:secrets": "node scripts/check-secrets.mjs dist",
    "lighthouse": "node scripts/lighthouse.mjs",
    "visual": "VISUAL=1 playwright test e2e/visual.spec.ts --project=desktop",
    "visual:update": "VISUAL=1 playwright test e2e/visual.spec.ts --project=desktop --update-snapshots",
    "brand-assets": "node scripts/make-brand-assets.mjs"
  },
  "dependencies": {
    "@deck.gl/aggregation-layers": "9.4.0",
    "@deck.gl/core": "9.4.0",
    "@deck.gl/layers": "9.4.0",
    "@deck.gl/mapbox": "9.4.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/inter-tight": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@luma.gl/core": "9.4.2",
    "@math.gl/web-mercator": "4.1.0",
    "@react-three/drei": "9.122.0",
    "@react-three/fiber": "8.18.0",
    "@supabase/supabase-js": "2.117.2",
    "d3-geo": "^3.1.1",
    "framer-motion": "^13.4.4",
    "gsap": "^3.15.0",
    "lucide-react": "^1.48.0",
    "maplibre-gl": "6.11.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "three": "0.171.0",
    "topojson-client": "^3.1.0",
    "us-atlas": "^3.0.1",
    "zod": "^3.25.76",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@electric-sql/pglite": "^0.5.8",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.56.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/d3-geo": "^3.1.1",
    "@types/node": "^22.20.4",
    "@types/pg": "8.15.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/three": "0.171.0",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.1",
    "chrome-launcher": "^1.2.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.7",
    "gifenc": "^1.0.3",
    "globals": "^17.12.0",
    "jsdom": "^30.1.1",
    "lighthouse": "^12.8.2",
    "pg": "8.16.3",
    "playwright-core": "1.56.1",
    "pngjs": "^7.0.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^6.4.3",
    "vitest": "^3.2.7",
    "world-atlas": "^2.0.2"
  },
  "overrides": {
    "@luma.gl/core": "9.4.2",
    "@luma.gl/engine": "9.4.2",
    "@luma.gl/gpgpu": "9.4.2",
    "@luma.gl/shadertools": "9.4.2",
    "@luma.gl/webgl": "9.4.2",
    "@luma.gl/webgpu": "9.4.2"
  }
}
