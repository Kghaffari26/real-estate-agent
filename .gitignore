__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.venv/
venv/
*.egg-info/
.env

# Large downloaded/derived data - never committed
data/cache/real_estate/*
!data/cache/real_estate/.gitkeep

# agents_core.http's on-disk TTL cache (FRED/ACS responses); local only.
.cache/

# Published output (agents_core.settings.publish_dir(), default "public-data/")
# is regenerated on every run; agents-core's run-agent.yml force-pushes it to
# this repo's `data` branch instead. schemas/real_estate.schema.json IS
# committed (small, useful for PR diffs of the site contract).
#
# data/costs.jsonl, data/guard_failures.jsonl and data/real_estate/ ARE
# committed: they're run state that run-agent.yml commits back after each run.
public-data/

evals/results/*
!evals/results/.gitkeep
