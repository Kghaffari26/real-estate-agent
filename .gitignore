__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.venv/
venv/
*.egg-info/
.env

# Large downloaded/derived data - never committed
data/cache/real_estate/*
!data/cache/real_estate/.gitkeep

# Published site output is regenerated by the agent; keep out of the repo
# until the site build actually consumes it (Phase 4).
site/public/data/real_estate/*.json
site/public/data/real_estate/metros/*.json
site/public/data/real_estate/history/*.json
!site/public/data/real_estate/metros/.gitkeep
!site/public/data/real_estate/history/.gitkeep

data/costs.jsonl
evals/results/*
!evals/results/.gitkeep
