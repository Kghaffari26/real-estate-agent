{
  "name": "real-estate-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/fetch-data.mjs --if-missing",
    "dev": "vite",
    "prebuild": "node scripts/fetch-data.mjs --if-missing",
    "build": "vite build",
    "preview": "vite preview",
    "gen:schema": "node scripts/gen-schema.mjs",
    "check:schema": "node scripts/gen-schema.mjs --check",
    "fetch-data": "node scripts/fetch-data.mjs",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "screenshots": "SCREENSHOTS=1 playwright test e2e/screenshots.spec.ts",
    "check:bundle": "node scripts/check-bundle.mjs --budget 300",
    "brand-assets": "node scripts/make-brand-assets.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "framer-motion": "^13.4.4",
    "lucide-react": "^1.48.0",
    "maplibre-gl": "^6.11.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "recharts": "^2.15.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.56.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.20.4",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "jsdom": "^30.1.1",
    "playwright-core": "1.56.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "topojson-client": "^3.1.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "us-atlas": "^3.0.1",
    "vite": "^6.4.3",
    "vitest": "^3.2.7"
  }
}
